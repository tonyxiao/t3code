{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "private": {
      "extends": "preview",
      "channel": "private",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "T3CODE_MOBILE_APP_ID": "com.txlforge.t3code",
        "T3CODE_MOBILE_SCHEME": "txlforge-t3",
        "T3CODE_MOBILE_SLUG": "t3-code-mobile",
        "T3CODE_MOBILE_EAS_OWNER": "txlforge",
        "T3CODE_MOBILE_EAS_PROJECT_ID": "2f5c604c-ae7f-48f4-bbdb-bdac2006d47c",
        "T3CODE_MOBILE_UPDATES_ENABLED": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "development",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal"
    },
    "preview:dev": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "MOBILE_VERSION_POLICY": "fingerprint",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "v2-preview": {
      "extends": "production",
      "distribution": "store",
      "channel": "v2-preview",
      "env": {
        "T3CODE_MOBILE_UPDATES_ENABLED": "0"
      }
    },
    "production": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "production",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "v2-preview": {
      "extends": "production",
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6787819824"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
