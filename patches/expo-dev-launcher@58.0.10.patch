@@ -17,6 +17,29 @@ private class DevLauncherWrapperView: UIView {
   }
 
 #if !os(macOS)
+  override func didMoveToWindow() {
+    super.didMoveToWindow()
+    guard window != nil, let viewController = devLauncherViewController,
+      viewController.parent == nil else {
+      return
+    }
+
+    // SwiftUI needs controller containment to receive appearance events. The
+    // factory initially installs only this wrapper view, before mount() runs.
+    var responder = next
+    while let current = responder {
+      if let parent = current as? UIViewController {
+        viewController.view.removeFromSuperview()
+        parent.addChild(viewController)
+        addSubview(viewController.view)
+        setupDevLauncherView(viewController)
+        viewController.didMove(toParent: parent)
+        break
+      }
+      responder = current.next
+    }
+  }
+
