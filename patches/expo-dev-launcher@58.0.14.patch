@@ -6,6 +6,29 @@ public class DevLauncherModule: Module {
   public func definition() -> ModuleDefinition {
     Name("ExpoDevLauncher")
 
+    Function("getSourceInfo") {
+      let controller = EXDevLauncherController.sharedInstance()
+      let source = controller.sourceUrl()
+      let remote = source?.scheme == "http" || source?.scheme == "https"
+      let updatesRuntime = controller.getUpdatesConfig(nil)["runtimeVersion"] as? String ?? ""
+      let embeddedRuntime = Bundle.main.path(forResource: "Expo", ofType: "plist")
+        .flatMap { NSDictionary(contentsOfFile: $0)?["EXUpdatesRuntimeVersion"] as? String } ?? ""
+      let runtimeVersion = !updatesRuntime.isEmpty ? updatesRuntime :
+        (embeddedRuntime.hasPrefix("file:") ? "" : embeddedRuntime)
+      return [
+        "runtimeVersion": runtimeVersion,
+        "serverUrl": remote ? (source?.absoluteString ?? "") as Any : NSNull()
+      ] as [String: Any]
+    }
+
+    AsyncFunction("loadEmbeddedBundle") { (promise: Promise) in
+      EXDevLauncherController.sharedInstance().loadLocalBundle(onSuccess: {
+        promise.resolve(true)
+      }, onError: { error in
+        promise.reject(DevLauncherLoadAppException(error.localizedDescription).causedBy(error))
+      })
+    }.runOnQueue(.main)
+
     AsyncFunction("loadApp") { (url: URL, promise: Promise) in
       if url.scheme == nil {
         throw DevLauncherInvalidURLException()
